{
  "name": "@turtletech/ookcite-mcp",
  "version": "0.4.8",
  "description": "MCP server for citation validation, formatting, and collection management. Validates DOIs, formats references in 2900+ CSL styles, manages citation collections, and catches hallucinated citations.",
  "bin": {
    "ookcite-mcp": "bin/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "mcp",
    "citations",
    "doi",
    "bibtex",
    "academic",
    "model-context-protocol"
  ],
  "homepage": "https://ookcite.turtletech.us",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TurtleTech-ehf/ookcite-mcp.git"
  },
  "license": "MIT"
}
