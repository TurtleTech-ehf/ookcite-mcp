#!/usr/bin/env sh
# Launch ookcite-mcp with an API key fetched at start, so the key never sits in
# an MCP client's configuration file.
#
# Two properties of stdio MCP constrain how a wrapper may fetch a secret, and
# getting either wrong looks like the server hanging rather than like a
# credential problem:
#
#   * The client speaks JSON-RPC over this process's stdin, and anything run
#     before exec inherits it. A helper that reads stdin consumes the client's
#     `initialize` request; the server then waits for a message that is already
#     gone, and the client eventually times the connection out. Every command
#     below runs with </dev/null.
#
#   * A secret store may block indefinitely. gpg asks for a passphrase over its
#     own agent socket, which </dev/null does not reach, so a locked key parks
#     the launch on a prompt the client cannot see. Clients allow tens of
#     seconds to connect, so every lookup here is bounded well inside that.
#
# Configure with exactly one of:
#
#   OOKCITE_API_KEY           an already-resolved key, used as-is
#   OOKCITE_API_KEY_COMMAND   a shell command printing the key on stdout
#   OOKCITE_API_KEY_FILE      a file whose first line is the key
#
# Example MCP client entry:
#
#   {
#     "mcpServers": {
#       "ookcite": {
#         "command": "/path/to/ookcite-mcp-credential-helper",
#         "env": {
#           "OOKCITE_API_KEY_COMMAND": "pass show services/ookcite-api-key"
#         }
#       }
#     }
#   }
#
# Running with no key configured is supported: the server starts anonymous.
set -eu

timeout_secs="${OOKCITE_API_KEY_TIMEOUT:-10}"

warn() { printf 'ookcite-mcp-credential-helper: %s\n' "$*" >&2; }

# `timeout` is in coreutils and busybox but not guaranteed; without it, run the
# lookup unbounded rather than refusing to start, and say so once.
run_bounded() {
    if command -v timeout >/dev/null 2>&1; then
        timeout "$timeout_secs" "$@" </dev/null
    else
        warn "timeout(1) not found; running the key lookup unbounded"
        "$@" </dev/null
    fi
}

first_line() {
    # Trailing whitespace and CR are the usual result of a secret pasted into a
    # file, and both produce a confusing 401 rather than an obvious error.
    sed -n '1p' | tr -d '\r' | sed 's/[[:space:]]*$//'
}

if [ -z "${OOKCITE_API_KEY:-}" ]; then
    key=""
    if [ -n "${OOKCITE_API_KEY_COMMAND:-}" ]; then
        key=$(run_bounded sh -c "$OOKCITE_API_KEY_COMMAND" 2>/dev/null | first_line) || key=""
        [ -n "$key" ] || warn "OOKCITE_API_KEY_COMMAND produced no key"
    elif [ -n "${OOKCITE_API_KEY_FILE:-}" ]; then
        if [ -r "$OOKCITE_API_KEY_FILE" ]; then
            key=$(first_line < "$OOKCITE_API_KEY_FILE") || key=""
        else
            warn "OOKCITE_API_KEY_FILE is not readable: $OOKCITE_API_KEY_FILE"
        fi
    fi
    if [ -n "$key" ]; then
        OOKCITE_API_KEY="$key"
        export OOKCITE_API_KEY
    fi
fi

bin="${OOKCITE_MCP_BIN:-}"
if [ -z "$bin" ]; then
    bin=$(command -v ookcite-mcp 2>/dev/null || true)
fi
if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    warn "ookcite-mcp not found; set OOKCITE_MCP_BIN or put it on PATH"
    exit 127
fi

exec "$bin" "$@"
